# ── Server ────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend origin).
# Local dev: the Vite dev server. Production: your Vercel frontend URL.
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────
# Connection string for your PostgreSQL database with PostGIS enabled.
# Local example: postgresql://user:password@localhost:5432/job_service
# Neon example:  postgresql://user:password@ep-xxx.region.aws.neon.tech/job_service?sslmode=require
DATABASE_URL=DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/job_service?sslmode=require

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Secret used to sign access tokens. Use a long random string in production.
JWT_ACCESS_SECRET=VXrOIM48Xdr4ld3/T2qEDZoZlVY+rb2SNcE46VMfhTM=
# Secret used to sign refresh tokens. Use a different long random string.
JWT_REFRESH_SECRET=qQkHQSxiQ/k7QIzHrneKhiBIcCVF72RTd1kNEgjUCGY=
# Access token lifetime, e.g. 15m, 1h, 7d.
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime, e.g. 7d, 30d.
JWT_REFRESH_EXPIRES_IN=7d

# ── Environment ───────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development