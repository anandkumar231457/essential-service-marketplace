# Base URL of the backend API. Used by the frontend to make requests.
# In local dev, the Vite dev server proxies /api to the backend (see vite.config.ts).
# In production (Vercel), set this to your deployed backend URL, e.g. https://api.your-app.com
VITE_API_URL=http://localhost:4000/api

# Base URL of the Socket.io server for realtime features (live tracking).
# In local dev this is the same backend host. In production, set to your deployed backend.
VITE_SOCKET_URL=http://localhost:4000